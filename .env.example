# Postgres connection string. Supabase: Project Settings > Database > Connection string (use the pooler URL on Vercel).
DATABASE_URL=postgres://hub:hub@localhost:5432/hub
# Shared secret the GitHub Actions uploader sends as "Authorization: Bearer <token>". Generate with: openssl rand -hex 32
INGEST_TOKEN=

# --- Sign-in ---
# Who may sign in: addresses and/or whole domains, comma separated. Empty means nobody can sign in.
# Example: ALLOWED_EMAILS=fikri@example.com, lead@example.com, @mystudylife.com
ALLOWED_EMAILS=
# The address people open, used to build the links in sign-in emails. Required in production.
APP_URL=http://localhost:3000
# How sign-in emails are sent. Gmail: smtps://you%40gmail.com:<16-letter app password>@smtp.gmail.com:465
# Leave empty locally: the link is printed in the terminal running `npm run dev` instead.
SMTP_URL=
MAIL_FROM=MSL Test Hub <you@gmail.com>
